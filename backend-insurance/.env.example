# Insurance Underwriting Officer — Backend Environment Variables
# Copy this to .env and fill in real values (never commit .env)

# Tavus CVI — create a new persona/replica in the Tavus dashboard for Aria
TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_PERSONA_ID=your_insurance_persona_id_here
TAVUS_REPLICA_ID=your_insurance_replica_id_here

# Lead capture URL shown in QR code after memo is complete
LEAD_CAPTURE_URL=https://yourdomain.com/insurance-pilot

# Port (5001 to avoid conflict with CDO backend on 5000)
PORT=5001
