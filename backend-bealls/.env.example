# Bealls Sales Command Center — Backend Environment Variables
# Copy this to .env and fill in real values (never commit .env)

# Tavus CVI — Bealls Analyst (casual replica)
TAVUS_API_KEY=your_tavus_api_key_here
TAVUS_PERSONA_ID=p56515f51bee
TAVUS_REPLICA_ID=r3f427f43c9d

# AWS S3 for retail data
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET=bealls-bucket
S3_DATA_PREFIX=retail_data/

# Gemini API (LLM for agents)
GEMINI_API_KEY=your_gemini_api_key_here

# Port (5002 to avoid conflict with other backends)
PORT=5002
